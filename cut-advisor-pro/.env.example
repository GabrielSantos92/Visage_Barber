# Variáveis do site (Vite). Todas são PÚBLICAS: entram no pacote publicado e
# qualquer visitante pode lê-las. Nunca coloque aqui a chave service_role nem
# outro segredo.
#
# Local: copie para .env e preencha. Hospedagem (Vercel ou Render): configure no
# painel do projeto. O build de produção para se alguma faltar, e na hospedagem
# também recusa VITE_API_URL apontando para localhost (ver vite.config.ts).

# URL do projeto Supabase (Project Settings > API)
VITE_SUPABASE_URL=

# Chave publicável do Supabase (anon / sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend (API). Produção: https://visage-backend-vnfg.onrender.com
# Local: http://localhost:3001
VITE_API_URL=
