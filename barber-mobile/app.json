{
  "expo": {
    "name": "Visage Barber",
    "slug": "barber-mobile",
    "scheme": "visagebarber",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080808"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.visagebarber.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080808"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Permita que o Visage Barber acesse suas fotos para salvar a comparação do visagismo.",
          "savePhotosPermission": "Permita que o Visage Barber salve a comparação do visagismo na sua galeria.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "261c10ee-86ac-4b14-8e8e-975558da3f36"
      }
    }
  }
}
