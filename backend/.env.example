PORT=3001

# Ambiente do backend (OBRIGATÓRIO, sem valor padrão): producao, teste ou
# desenvolvimento. Ausente ou outro valor: o backend não atende nada (503).
#   producao         recusa um banco marcado como de teste.
#   teste            só atende com SUPABASE_URL de um projeto Supabase que não
#                    é o de produção E com o banco marcado
#                    (supabase/teste/marcar_banco_de_teste.sql).
#   desenvolvimento  só na sua máquina (recusado no Render); usa o banco do
#                    .env sem conferir a marca; o WhatsApp não liga.
# Antes de liberar, todo /api responde 503 e nenhuma chamada ao banco sai
# (backend/src/services/ambienteServidor.js).
BACKEND_AMBIENTE=

# Supabase — Dashboard > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta: só no backend, nunca no app ou no site. É a ÚNICA chave que o
# backend usa (sem ela, nada é atendido; a anon nunca é usada no lugar).
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
PEXELS_API_KEY=
REPLICATE_API_KEY=
# Opcional: modelo de análise do visagismo no Replicate (padrão google/gemini-3-flash).
# Troque aqui se o Replicate retirar o modelo (erro 410), sem mudar código.
REPLICATE_MODELO_ANALISE=

# Atrás de proxy/load balancer: quantos saltos confiar para obter o IP real
# (usado nos limites de requisição). Deixe vazio em desenvolvimento.
# No Render, use 1: o proxy do Render acrescenta o IP real ao fim do
# X-Forwarded-For, e com 1 o Express usa essa última entrada (nunca a que o
# cliente pode forjar no começo). O IP só serve para frear tentativas
# inválidas; nenhuma rota autentica pelo IP.
TRUST_PROXY=

# Pagamentos online — Mercado Pago (conta da barbearia)
# Painel: https://www.mercadopago.com.br/developers/panel/app > sua aplicação
#   Credenciais de teste para desenvolvimento; de produção só depois de validar.
#   Sem MERCADOPAGO_ACCESS_TOKEN, só o pagamento presencial fica disponível.
MERCADOPAGO_ACCESS_TOKEN=
# Webhooks > Configurar notificações: eventos "Pagamentos" (cartão) e "Order
# (Mercado Pago)" (PIX), com a URL pública https://SEU-BACKEND/api/pagamentos/webhook.
# A "assinatura secreta" vai aqui. O PIX não leva URL própria: só a do painel vale.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
# "teste" usa o link de sandbox do Checkout Pro quando o Mercado Pago o devolve
MERCADOPAGO_AMBIENTE=teste
# Só em teste: e-mail da conta compradora de teste, enviado como pagador do PIX
# (com credenciais de teste, o Mercado Pago recusa e-mail de cliente real com
# "Unauthorized use of live credentials"). Ignorado fora do ambiente "teste".
MERCADOPAGO_EMAIL_PAGADOR_TESTE=
# Página do site para onde o cliente volta depois do cartão (https em produção)
PAGAMENTO_RETORNO_URL=http://localhost:8080/pagamento
# Validade do QR Code PIX, em minutos
PAGAMENTO_PIX_MINUTOS=30

# Avisos (fila no banco, lida pelo backend). Nada liga por padrão; cada canal
# tem a sua chave. NUNCA crie a variável antiga NOTIFICACOES_ATIVAS (nem com
# "false"): se ela existir, nenhum canal liga.
#
# Segredo compartilhado com o Supabase: o banco o envia no cabeçalho
# X-Notificacoes-Segredo ao chamar POST /api/notificacoes/processar. O mesmo
# valor vai para o Supabase Vault (nome notificacoes_segredo_backend).
# Mínimo de 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca no app, no site ou no Git.
NOTIFICACOES_SEGREDO=
# Leitura da fila enquanto o servidor está acordado, e tempo máximo de cada
# chamada externa (em segundos)
NOTIFICACOES_INTERVALO_SEGUNDOS=20
NOTIFICACOES_TIMEOUT_SEGUNDOS=10

# WhatsApp Business Platform (Cloud API oficial da Meta): confirmação de
# presença 2 horas antes do atendimento. Só liga com "true" E todas as
# variáveis WHATSAPP_ obrigatórias preenchidas.
NOTIFICACOES_WHATSAPP_ATIVO=
# Meta for Developers > seu app > WhatsApp > Configuração da API
WHATSAPP_PHONE_NUMBER_ID=
# Token permanente de um usuário do sistema (permissão whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN=
# Chave secreta do app (Configurações > Básico): valida a assinatura do webhook
WHATSAPP_APP_SECRET=
# Texto que você escolhe e repete no cadastro do webhook (mínimo de 16 caracteres).
# URL do webhook: https://SEU-BACKEND/api/whatsapp/webhook (campo "messages")
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Nome do template aprovado da confirmação (utilidade, pt_BR, dois botões de
# resposta rápida, nesta ordem: SIM e NÃO; variáveis: cliente, serviço,
# barbeiro, data, hora). Com a migration 26, o texto deve dizer que NÃO abre
# uma confirmação de cancelamento (nada é cancelado no primeiro toque).
# A segunda mensagem ("Tem certeza de que deseja cancelar?") não usa template:
# é uma mensagem interativa enviada dentro da janela de 24 h aberta pelo toque.
WHATSAPP_TEMPLATE_CONFIRMACAO=
# Opcional (fluxo da migration 25): aviso ao barbeiro quando o cliente responde
# NÃO (variáveis: cliente, serviço, data, hora).
WHATSAPP_TEMPLATE_PRESENCA_NEGADA=
# Opcional (migration 26): aviso ao barbeiro quando o cliente CONFIRMA o
# cancelamento pelo WhatsApp (variáveis: cliente, serviço, data, hora). Sem
# ele, o barbeiro vê o cancelamento só na agenda.
WHATSAPP_TEMPLATE_CANCELAMENTO=
# Opcional (migration 26): aviso ao CLIENTE quando a segunda mensagem ("Tem
# certeza de que deseja cancelar?") não chegou: o pedido foi recebido, o
# cancelamento NÃO foi feito, o horário continua reservado e ele deve cancelar
# pelo app, pelo site ou com a barbearia (variáveis: data, hora). Sem ele, o
# aviso vai como texto, que só chega com a janela de 24 h aberta.
WHATSAPP_TEMPLATE_CANCELAMENTO_NAO_CONCLUIDO=
# Opcionais (migration 28): confirmação de novo agendamento, sem botões.
# Cliente: cliente, serviço, barbeiro, data, hora. Barbeiro: cliente, serviço,
# data, hora. Sem eles, o aviso termina como não enviado.
WHATSAPP_TEMPLATE_NOVO_AGENDAMENTO_CLIENTE=
WHATSAPP_TEMPLATE_NOVO_AGENDAMENTO_BARBEIRO=
# Opcionais (migration 29): aviso de cancelamento efetivado, sem botões, com
# as mesmas variáveis dos de novo agendamento. Sem eles, não é enviado.
WHATSAPP_TEMPLATE_CANCELAMENTO_CLIENTE=
WHATSAPP_TEMPLATE_CANCELAMENTO_BARBEIRO=
# Opcionais: idioma do template (padrão pt_BR) e versão da Graph API
WHATSAPP_TEMPLATE_IDIOMA=
WHATSAPP_API_VERSAO=
# Piloto: ids de usuários (separados por vírgula) que podem receber. Vazio = todos.
WHATSAPP_PILOTO_USUARIOS=

# Ambiente do WhatsApp: "producao" ou "teste", sempre explícito e IGUAL a
# BACKEND_AMBIENTE. Vazio, outro valor ou diferente do backend: o WhatsApp não
# liga (vazio NÃO vale como produção).
# "teste" exige um projeto Supabase SÓ de teste (SUPABASE_URL e
# SUPABASE_SERVICE_ROLE_KEY dele, nunca os de produção), marcado com
# supabase/teste/marcar_banco_de_teste.sql. Sem a marca, ou apontando para o
# projeto de produção, o backend inteiro não atende.
# Em "teste", o backend lê SÓ as variáveis WHATSAPP_TESTE_* abaixo (as de
# produção acima são ignoradas, menos WHATSAPP_APP_SECRET e
# WHATSAPP_WEBHOOK_VERIFY_TOKEN, que são do app da Meta e valem para os dois).
# Teste e produção não podem ter o mesmo Phone Number ID nem o mesmo token.
WHATSAPP_AMBIENTE=
# Número de teste da Meta (WhatsApp > Configuração da API): Phone Number ID
WHATSAPP_TESTE_PHONE_NUMBER_ID=
# Token SÓ para testes (nunca o de produção). Nunca no Git, no site ou no app.
WHATSAPP_TESTE_ACCESS_TOKEN=
# Templates criados e aprovados na conta (WABA) do número de teste
WHATSAPP_TESTE_TEMPLATE_CONFIRMACAO=
WHATSAPP_TESTE_TEMPLATE_PRESENCA_NEGADA=
WHATSAPP_TESTE_TEMPLATE_CANCELAMENTO=
WHATSAPP_TESTE_TEMPLATE_CANCELAMENTO_NAO_CONCLUIDO=
WHATSAPP_TESTE_TEMPLATE_NOVO_AGENDAMENTO_CLIENTE=
WHATSAPP_TESTE_TEMPLATE_NOVO_AGENDAMENTO_BARBEIRO=
WHATSAPP_TESTE_TEMPLATE_CANCELAMENTO_CLIENTE=
WHATSAPP_TESTE_TEMPLATE_CANCELAMENTO_BARBEIRO=
# Obrigatório em "teste": celulares autorizados (até 5, separados por vírgula),
# com 55, DDD e o 9. Ex.: 5511987654321. Só eles recebem; mensagens de outros
# números que chegarem ao webhook são ignoradas.
WHATSAPP_TESTE_DESTINATARIOS=

# Push pela Expo (Android). Liga só com as duas variáveis abaixo E com o
# marcador do banco ligado (migration 30: notificacao_config.push_ativo), que é
# o ÚLTIMO passo. Com o marcador desligado, o banco não acorda o backend e nada
# é reservado, mesmo com estas variáveis preenchidas. Ao ligar o marcador, os
# avisos antigos ainda pendentes são ignorados (nunca saem pelo push).
# Token de acesso da Expo (expo.dev > Account settings > Access tokens), com a
# segurança de push ativada no projeto. Nunca no app, no site ou no Git.
NOTIFICACOES_PUSH_ATIVO=
EXPO_ACCESS_TOKEN=
