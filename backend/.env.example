PORT=3001

# Supabase — Dashboard > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Chave secreta: só no backend, nunca no app ou no site
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
PEXELS_API_KEY=
REPLICATE_API_KEY=

# Atrás de proxy/load balancer: quantos saltos confiar para obter o IP real
# (usado nos limites de requisição). Deixe vazio em desenvolvimento.
# No Render, use 1: o proxy do Render acrescenta o IP real ao fim do
# X-Forwarded-For, e com 1 o Express usa essa última entrada (nunca a que o
# cliente pode forjar no começo). O IP só serve para frear tentativas
# inválidas; nenhuma rota autentica pelo IP.
TRUST_PROXY=

# Pagamentos online — Mercado Pago (conta da barbearia)
# Painel: https://www.mercadopago.com.br/developers/panel/app > sua aplicação
#   Credenciais de teste para desenvolvimento; de produção só depois de validar.
#   Sem MERCADOPAGO_ACCESS_TOKEN, só o pagamento presencial fica disponível.
MERCADOPAGO_ACCESS_TOKEN=
# Webhooks > Configurar notificações: evento "Pagamentos" e a URL pública
# https://SEU-BACKEND/api/pagamentos/webhook. A "assinatura secreta" vai aqui.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
# "teste" usa o link de sandbox do Checkout Pro quando o Mercado Pago o devolve
MERCADOPAGO_AMBIENTE=teste
# Página do site para onde o cliente volta depois do cartão (https em produção)
PAGAMENTO_RETORNO_URL=http://localhost:8080/pagamento
# Validade do QR Code PIX, em minutos
PAGAMENTO_PIX_MINUTOS=30

# Notificações push (Expo). Sem "true", nada é enviado e as rotas
# /api/notificacoes respondem 503.
NOTIFICACOES_ATIVAS=false
# Segredo compartilhado com o Supabase: o banco o envia no cabeçalho
# X-Notificacoes-Segredo ao chamar POST /api/notificacoes/processar. O mesmo
# valor vai para o Supabase Vault (nome notificacoes_segredo_backend).
# Mínimo de 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca no app, no site ou no Git.
NOTIFICACOES_SEGREDO=
# Token de acesso da Expo (expo.dev > Account settings > Access tokens).
# Obrigatório com a "segurança de push" ligada no projeto. Só no backend.
EXPO_ACCESS_TOKEN=
# Leitura da fila enquanto o servidor está acordado, e tempo máximo de cada
# chamada à Expo (em segundos)
NOTIFICACOES_INTERVALO_SEGUNDOS=20
NOTIFICACOES_TIMEOUT_SEGUNDOS=10
