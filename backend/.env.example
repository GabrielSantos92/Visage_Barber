PORT=3001

# Supabase — Dashboard > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Chave secreta: só no backend, nunca no app ou no site
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
PEXELS_API_KEY=
REPLICATE_API_KEY=

# Atrás de proxy/load balancer: quantos saltos confiar para obter o IP real
# (usado nos limites de requisição). Deixe vazio em desenvolvimento.
# No Render, use 1: o proxy do Render acrescenta o IP real ao fim do
# X-Forwarded-For, e com 1 o Express usa essa última entrada (nunca a que o
# cliente pode forjar no começo). O IP só serve para frear tentativas
# inválidas; nenhuma rota autentica pelo IP.
TRUST_PROXY=

# Pagamentos online — Mercado Pago (conta da barbearia)
# Painel: https://www.mercadopago.com.br/developers/panel/app > sua aplicação
#   Credenciais de teste para desenvolvimento; de produção só depois de validar.
#   Sem MERCADOPAGO_ACCESS_TOKEN, só o pagamento presencial fica disponível.
MERCADOPAGO_ACCESS_TOKEN=
# Webhooks > Configurar notificações: evento "Pagamentos" e a URL pública
# https://SEU-BACKEND/api/pagamentos/webhook. A "assinatura secreta" vai aqui.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
# "teste" usa o link de sandbox do Checkout Pro quando o Mercado Pago o devolve
MERCADOPAGO_AMBIENTE=teste
# Página do site para onde o cliente volta depois do cartão (https em produção)
PAGAMENTO_RETORNO_URL=http://localhost:8080/pagamento
# Validade do QR Code PIX, em minutos
PAGAMENTO_PIX_MINUTOS=30

# Avisos (fila no banco, lida pelo backend). Nada liga por padrão; cada canal
# tem a sua chave. NUNCA crie a variável antiga NOTIFICACOES_ATIVAS (nem com
# "false"): se ela existir, nenhum canal liga.
#
# Segredo compartilhado com o Supabase: o banco o envia no cabeçalho
# X-Notificacoes-Segredo ao chamar POST /api/notificacoes/processar. O mesmo
# valor vai para o Supabase Vault (nome notificacoes_segredo_backend).
# Mínimo de 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca no app, no site ou no Git.
NOTIFICACOES_SEGREDO=
# Leitura da fila enquanto o servidor está acordado, e tempo máximo de cada
# chamada externa (em segundos)
NOTIFICACOES_INTERVALO_SEGUNDOS=20
NOTIFICACOES_TIMEOUT_SEGUNDOS=10

# WhatsApp Business Platform (Cloud API oficial da Meta): confirmação de
# presença 2 horas antes do atendimento. Só liga com "true" E todas as
# variáveis WHATSAPP_ obrigatórias preenchidas.
NOTIFICACOES_WHATSAPP_ATIVO=
# Meta for Developers > seu app > WhatsApp > Configuração da API
WHATSAPP_PHONE_NUMBER_ID=
# Token permanente de um usuário do sistema (permissão whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN=
# Chave secreta do app (Configurações > Básico): valida a assinatura do webhook
WHATSAPP_APP_SECRET=
# Texto que você escolhe e repete no cadastro do webhook (mínimo de 16 caracteres).
# URL do webhook: https://SEU-BACKEND/api/whatsapp/webhook (campo "messages")
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Nome do template aprovado da confirmação (utilidade, pt_BR, dois botões de
# resposta rápida "Sim" e "Não"; variáveis: cliente, serviço, barbeiro, data, hora)
WHATSAPP_TEMPLATE_CONFIRMACAO=
# Opcional: template do aviso ao barbeiro quando o cliente responde NÃO
# (variáveis: cliente, serviço, data, hora). Sem ele, o barbeiro vê só na agenda.
WHATSAPP_TEMPLATE_PRESENCA_NEGADA=
# Opcionais: idioma do template (padrão pt_BR) e versão da Graph API
WHATSAPP_TEMPLATE_IDIOMA=
WHATSAPP_API_VERSAO=
# Piloto: ids de usuários (separados por vírgula) que podem receber. Vazio = todos.
WHATSAPP_PILOTO_USUARIOS=

# Push pela Expo: cancelado (o canal é o WhatsApp). Só ligaria com as duas.
NOTIFICACOES_PUSH_ATIVO=
EXPO_ACCESS_TOKEN=
